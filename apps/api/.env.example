NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cvuser:cvpass@postgres:5432/cvscreening
REDIS_URL=redis://redis:6379/0
PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
STORAGE_DRIVER=minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_CV=cv-files
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_OAUTH_CLIENT_ID=replace_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_google_client_secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
LINKEDIN_OAUTH_CLIENT_ID=replace_linkedin_client_id
LINKEDIN_OAUTH_CLIENT_SECRET=replace_linkedin_client_secret
LINKEDIN_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/linkedin/callback
AI_SERVICE_URL=http://ai-service:8000
AI_CACHE_TTL_SECONDS=86400
SENTRY_DSN=
