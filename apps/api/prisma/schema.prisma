generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  APPLIED
  AI_SCREENING
  HR_REVIEW
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum ReactionTargetType {
  POST
  COMMENT
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  INSIGHTFUL
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ConversationType {
  DIRECT
  GROUP
}

model User {
  id                     String                     @id @default(uuid()) @db.Uuid
  email                  String                     @unique
  passwordHash           String                     @map("password_hash")
  role                   UserRole
  isVerified             Boolean                    @default(false) @map("is_verified")
  createdAt              DateTime                   @default(now()) @map("created_at")
  deletedAt              DateTime?                  @map("deleted_at")
  profile                UserProfile?
  workExperiences        WorkExperience[]
  educations             Education[]
  userSkills             UserSkill[]
  skillEndorsementsGiven SkillEndorsement[]         @relation("EndorsementsGiven")
  skillEndorsements      SkillEndorsement[]         @relation("EndorsementsReceived")
  cvFiles                CvFile[]
  companyMemberships     CompanyMember[]
  jobsCreated            Job[]                      @relation("JobsCreatedByUser")
  applications           Application[]              @relation("CandidateApplications")
  statusChanges          ApplicationStatusHistory[] @relation("ApplicationStatusChangedBy")
  posts                  Post[]
  comments               Comment[]
  reactions              Reaction[]
  requestedConnections   Connection[]               @relation("ConnectionRequester")
  addressedConnections   Connection[]               @relation("ConnectionAddressee")
  conversationLinks      ConversationParticipant[]
  messages               Message[]
  notifications          Notification[]
  savedJobs              SavedJob[]
  jobAlerts              JobAlert[]
  companyFollows         CompanyFollower[]
  generatedCvs           GeneratedCv[]
  certifications         Certification[]
  projects               Project[]
  moderationReports      ModerationReport[]         @relation("ModerationReporter")
  privacySettings        PrivacySettings?

  @@index([role], map: "users_role_idx")
  @@index([isVerified], map: "users_is_verified_idx")
  @@index([createdAt], map: "users_created_at_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

model UserProfile {
  userId              String  @id @map("user_id") @db.Uuid
  fullName            String  @map("full_name")
  headline            String?
  about               String?
  avatarUrl           String? @map("avatar_url")
  coverUrl            String? @map("cover_url")
  location            String?
  socialLinks         Json?   @map("social_links")
  languages           Json?
  publicSlug          String? @unique @map("public_slug")
  profileCompleteness Int     @default(0) @map("profile_completeness")
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location], map: "user_profiles_location_idx")
  @@index([profileCompleteness], map: "user_profiles_completeness_idx")
  @@map("user_profiles")
}

model Certification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  issuer        String
  issueDate     DateTime? @map("issue_date")
  credentialUrl String?   @map("credential_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "certifications_user_id_idx")
  @@map("certifications")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  url         String?
  skills      Json      @default("[]")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "projects_user_id_idx")
  @@map("projects")
}

model WorkExperience {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  company     String
  position    String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isCurrent   Boolean   @default(false) @map("is_current")
  description String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "work_experiences_user_id_idx")
  @@index([company], map: "work_experiences_company_idx")
  @@index([startDate], map: "work_experiences_start_date_idx")
  @@map("work_experiences")
}

model Education {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  school    String
  degree    String
  major     String?
  gpa       Decimal? @db.Decimal(3, 2)
  startYear Int      @map("start_year")
  endYear   Int?     @map("end_year")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "educations_user_id_idx")
  @@index([school], map: "educations_school_idx")
  @@index([startYear], map: "educations_start_year_idx")
  @@map("educations")
}

model Skill {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique
  category     String?
  userSkills   UserSkill[]
  endorsements SkillEndorsement[]

  @@index([category], map: "skills_category_idx")
  @@map("skills")
}

model UserSkill {
  userId   String     @map("user_id") @db.Uuid
  skillId  String     @map("skill_id") @db.Uuid
  level    SkillLevel
  yearsExp Decimal?   @map("years_exp") @db.Decimal(4, 1)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill    Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId], map: "user_skills_skill_id_idx")
  @@index([level], map: "user_skills_level_idx")
  @@map("user_skills")
}

model SkillEndorsement {
  endorserId String @map("endorser_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  skillId    String @map("skill_id") @db.Uuid
  endorser   User   @relation("EndorsementsGiven", fields: [endorserId], references: [id], onDelete: Cascade)
  user       User   @relation("EndorsementsReceived", fields: [userId], references: [id], onDelete: Cascade)
  skill      Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([endorserId, userId, skillId])
  @@index([userId, skillId], map: "skill_endorsements_user_skill_idx")
  @@index([endorserId], map: "skill_endorsements_endorser_idx")
  @@map("skill_endorsements")
}

model CvFile {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  fileUrl      String        @map("file_url")
  fileName     String        @map("file_name")
  fileSize     BigInt        @map("file_size")
  isPrimary    Boolean       @default(false) @map("is_primary")
  extractedText String?      @map("extracted_text")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId], map: "cv_files_user_id_idx")
  @@index([userId, isPrimary], map: "cv_files_user_primary_idx")
  @@map("cv_files")
}

model Company {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  slug        String            @unique
  logoUrl     String?           @map("logo_url")
  coverUrl    String?           @map("cover_url")
  website     String?
  industry    String?
  sizeRange   String?           @map("size_range")
  foundedYear Int?              @map("founded_year")
  address     String?
  description String?
  members     CompanyMember[]
  jobs        Job[]
  posts       Post[]
  followers   CompanyFollower[]

  @@index([industry], map: "companies_industry_idx")
  @@map("companies")
}

model CompanyMember {
  companyId String            @map("company_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      CompanyMemberRole
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId], map: "company_members_user_id_idx")
  @@index([companyId, role], map: "company_members_company_role_idx")
  @@map("company_members")
}

model Job {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  createdBy       String        @map("created_by") @db.Uuid
  title           String
  description     String
  jobType         String        @map("job_type")
  level           String
  experienceLevel String?       @map("experience_level")
  category        String?
  isRemote        Boolean       @default(false) @map("is_remote")
  minSalary       Int?          @map("min_salary")
  maxSalary       Int?          @map("max_salary")
  salaryCurrency  String        @default("VND") @map("salary_currency")
  location        String?
  requiredSkills  Json          @map("required_skills")
  status          JobStatus     @default(DRAFT)
  slug            String?       @unique
  viewsCount      Int           @default(0) @map("views_count")
  publishedAt     DateTime?     @map("published_at")
  expiresAt       DateTime?     @map("expires_at")
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator         User          @relation("JobsCreatedByUser", fields: [createdBy], references: [id], onDelete: Restrict)
  applications    Application[]
  savedBy         SavedJob[]

  @@index([companyId], map: "jobs_company_id_idx")
  @@index([createdBy], map: "jobs_created_by_idx")
  @@index([status], map: "jobs_status_idx")
  @@index([expiresAt], map: "jobs_expires_at_idx")
  @@index([location], map: "jobs_location_idx")
  @@index([category], map: "jobs_category_idx")
  @@index([experienceLevel], map: "jobs_experience_level_idx")
  @@index([isRemote], map: "jobs_is_remote_idx")
  @@index([publishedAt], map: "jobs_published_at_idx")
  @@map("jobs")
}

/// Aggregated job listings crawled from external sources (TopCV, VietnamWorks).
/// Kept separate from the platform-posted `Job` model: no company/creator FK,
/// only public listing data plus crawl bookkeeping.
model ExternalJob {
  id        String   @id @default(uuid()) @db.Uuid
  source    String
  title     String
  company   String
  salary    String?
  location  String?
  url       String   @unique
  jd        String?
  skills    Json     @default("[]")
  isActive  Boolean  @default(true) @map("is_active")
  crawledAt DateTime @default(now()) @map("crawled_at")

  @@index([source], map: "external_jobs_source_idx")
  @@index([crawledAt], map: "external_jobs_crawled_at_idx")
  @@map("external_jobs")
}

model Application {
  id            String                     @id @default(uuid()) @db.Uuid
  jobId         String                     @map("job_id") @db.Uuid
  candidateId   String                     @map("candidate_id") @db.Uuid
  cvFileId      String                     @map("cv_file_id") @db.Uuid
  coverLetter   String?                    @map("cover_letter")
  status        ApplicationStatus          @default(APPLIED)
  appliedAt     DateTime                   @default(now()) @map("applied_at")
  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     User                       @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  cvFile        CvFile                     @relation(fields: [cvFileId], references: [id], onDelete: Restrict)
  aiResult      AiScreeningResult?
  offer         Offer?
  statusHistory ApplicationStatusHistory[]

  @@unique([jobId, candidateId], map: "applications_job_candidate_unique")
  @@index([candidateId], map: "applications_candidate_id_idx")
  @@index([jobId], map: "applications_job_id_idx")
  @@index([status], map: "applications_status_idx")
  @@index([appliedAt], map: "applications_applied_at_idx")
  @@map("applications")
}

model AiScreeningResult {
  id               String      @id @default(uuid()) @db.Uuid
  applicationId    String      @unique @map("application_id") @db.Uuid
  overallScore     Decimal     @map("overall_score") @db.Decimal(5, 2)
  skillScore       Decimal     @map("skill_score") @db.Decimal(5, 2)
  experienceScore  Decimal     @map("experience_score") @db.Decimal(5, 2)
  educationScore   Decimal     @map("education_score") @db.Decimal(5, 2)
  otherScore       Decimal     @map("other_score") @db.Decimal(5, 2)
  grade            String
  matchedSkills    Json        @map("matched_skills")
  missingSkills    Json        @map("missing_skills")
  strengths        Json
  concerns         Json
  explanation      String
  modelVersion     String      @map("model_version")
  processingTimeMs Int         @map("processing_time_ms")
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([overallScore], map: "ai_screening_results_overall_score_idx")
  @@index([grade], map: "ai_screening_results_grade_idx")
  @@map("ai_screening_results")
}

/// Structured job offer sent by HR after the interview round. One offer per
/// application (re-sending an offer updates the same row). The candidate can
/// accept or decline, which drives the Application status to HIRED / REJECTED.
model Offer {
  id               String      @id @default(uuid()) @db.Uuid
  applicationId    String      @unique @map("application_id") @db.Uuid
  salaryAmount     Int?        @map("salary_amount")
  salaryCurrency   String      @default("VND") @map("salary_currency")
  startDate        DateTime?   @map("start_date")
  responseDeadline DateTime?   @map("response_deadline")
  note             String?
  offerLetterUrl   String?     @map("offer_letter_url")
  status           OfferStatus @default(PENDING)
  declineReason    String?     @map("decline_reason")
  createdBy        String      @map("created_by") @db.Uuid
  respondedAt      DateTime?   @map("responded_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([status], map: "offers_status_idx")
  @@map("offers")
}

model ApplicationStatusHistory {
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  changedBy     String             @map("changed_by") @db.Uuid
  note          String?
  changedAt     DateTime           @default(now()) @map("changed_at")
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedByUser User               @relation("ApplicationStatusChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  @@id([applicationId, changedAt, toStatus])
  @@index([changedBy], map: "application_status_history_changed_by_idx")
  @@index([applicationId, changedAt], map: "application_status_history_application_changed_at_idx")
  @@map("application_status_history")
}

model Post {
  id           String         @id @default(uuid()) @db.Uuid
  authorId     String         @map("author_id") @db.Uuid
  companyId    String?        @map("company_id") @db.Uuid
  content      String
  mediaUrls    Json?          @map("media_urls")
  visibility   PostVisibility @default(PUBLIC)
  likeCount    Int            @default(0) @map("like_count")
  commentCount Int            @default(0) @map("comment_count")
  createdAt    DateTime       @default(now()) @map("created_at")
  deletedAt    DateTime?      @map("deleted_at")
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  comments     Comment[]

  @@index([authorId, createdAt], map: "posts_author_created_at_idx")
  @@index([companyId, createdAt], map: "posts_company_created_at_idx")
  @@index([visibility], map: "posts_visibility_idx")
  @@index([deletedAt], map: "posts_deleted_at_idx")
  @@map("posts")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[] @relation("CommentToComment")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt], map: "comments_post_created_at_idx")
  @@index([parentId], map: "comments_parent_id_idx")
  @@index([authorId], map: "comments_author_id_idx")
  @@map("comments")
}

model Reaction {
  userId       String             @map("user_id") @db.Uuid
  targetType   ReactionTargetType @map("target_type")
  targetId     String             @map("target_id") @db.Uuid
  reactionType ReactionType       @default(LIKE) @map("reaction_type")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId], map: "reactions_target_idx")
  @@index([reactionType], map: "reactions_reaction_type_idx")
  @@map("reactions")
}

model Connection {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      ConnectionStatus @default(PENDING)
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId], map: "connections_requester_addressee_unique")
  @@index([requesterId, status], map: "connections_requester_status_idx")
  @@index([addresseeId, status], map: "connections_addressee_status_idx")
  @@map("connections")
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  type         ConversationType          @default(DIRECT)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([type], map: "conversations_type_idx")
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  lastReadAt     DateTime?    @map("last_read_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, lastReadAt], map: "conversation_participants_user_last_read_idx")
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  content        String
  isRead         Boolean      @default(false) @map("is_read")
  sentAt         DateTime     @default(now()) @map("sent_at")
  deletedAt      DateTime?    @map("deleted_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt], map: "messages_conversation_sent_at_idx")
  @@index([senderId, sentAt], map: "messages_sender_sent_at_idx")
  @@index([isRead], map: "messages_is_read_idx")
  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt], map: "notifications_user_read_created_idx")
  @@index([type], map: "notifications_type_idx")
  @@map("notifications")
}

enum AlertFrequency {
  DAILY
  WEEKLY
  INSTANT
}

model SavedJob {
  userId    String   @map("user_id") @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([userId, createdAt], map: "saved_jobs_user_created_idx")
  @@index([jobId], map: "saved_jobs_job_id_idx")
  @@map("saved_jobs")
}

model JobAlert {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  keyword    String?
  filters    Json?
  frequency  AlertFrequency @default(DAILY)
  isActive   Boolean        @default(true) @map("is_active")
  lastSentAt DateTime?      @map("last_sent_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "job_alerts_user_id_idx")
  @@index([isActive, frequency], map: "job_alerts_active_frequency_idx")
  @@map("job_alerts")
}

model CompanyFollower {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId], map: "company_followers_company_id_idx")
  @@map("company_followers")
}

model GeneratedCv {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  title      String
  templateId String   @default("classic") @map("template_id")
  data       Json
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary], map: "generated_cv_user_primary_idx")
  @@map("generated_cvs")
}

model ModerationReport {
  id         String   @id @default(uuid()) @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  reason     String
  details    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now()) @map("created_at")
  reporter   User     @relation("ModerationReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "moderation_reports_status_created_idx")
  @@index([targetType, targetId], map: "moderation_reports_target_idx")
  @@map("moderation_reports")
}

model PrivacySettings {
  userId            String   @id @map("user_id") @db.Uuid
  profileVisibility String   @default("PUBLIC") @map("profile_visibility")
  showActivity      Boolean  @default(true) @map("show_activity")
  showConnections   Boolean  @default(true) @map("show_connections")
  allowMessages     String   @default("EVERYONE") @map("allow_messages")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}
