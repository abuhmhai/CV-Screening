NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# LAN dev: open http://<your-pc-ip>:3000 on phone/tablet (same Wi‑Fi).
# API calls auto-target <your-pc-ip>:4000 when NEXT_PUBLIC_API_URL uses localhost.

# Production (Vercel) — see apps/web/.env.production
# NEXT_PUBLIC_APP_URL=https://cv-screening-ai-service.vercel.app
# NEXT_PUBLIC_API_URL=<NestJS API URL, NOT the web URL unless proxied>

# Optional — only needed if using Supabase Auth client-side
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
